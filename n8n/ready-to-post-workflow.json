{
  "name": "Post ready rows to Railway",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      },
      "id": "a1111111-1111-4111-8111-111111111111",
      "name": "Every 2 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [260, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.notion.com/v1/databases/REPLACE_NOTION_DATABASE_ID/query",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer REPLACE_NOTION_TOKEN" },
            { "name": "Notion-Version", "value": "2022-06-28" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"filter\": {\n    \"property\": \"Post Status\",\n    \"select\": { \"equals\": \"Ready to Post\" }\n  }\n}",
        "options": {}
      },
      "id": "b2222222-2222-4222-8222-222222222222",
      "name": "Notion: find Ready rows",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "results",
        "options": {}
      },
      "id": "c3333333-3333-4333-8333-333333333333",
      "name": "Split results",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [700, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://REPLACE_APP.up.railway.app/webhook",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Webhook-Secret", "value": "REPLACE_WEBHOOK_SECRET" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"page_id\": \"{{ $json.id }}\"\n}",
        "options": {}
      },
      "id": "d4444444-4444-4444-8444-444444444444",
      "name": "POST to Railway",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 300]
    }
  ],
  "connections": {
    "Every 2 minutes": {
      "main": [[{ "node": "Notion: find Ready rows", "type": "main", "index": 0 }]]
    },
    "Notion: find Ready rows": {
      "main": [[{ "node": "Split results", "type": "main", "index": 0 }]]
    },
    "Split results": {
      "main": [[{ "node": "POST to Railway", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
